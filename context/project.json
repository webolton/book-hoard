{
  "project": {
    "name": "Book-Hoard",
    "description": "A scholarly article and book cataloging application for organizing thousands of scanned academic articles and books",
    "purpose": "Provide searchable catalog, file management, and organization for scanned scholarly materials",
    "status": "early_development",
    "last_updated": "2025-12-30"
  },
  "technical_stack": {
    "backend": {
      "framework": "Ruby on Rails",
      "version": "8.0.2",
      "language": "Ruby",
      "database": "SQLite3",
      "production_database_recommendation": "PostgreSQL",
      "template_engine": "Slim",
      "background_jobs": "Solid Queue",
      "cache": "Solid Cache",
      "cable": "Solid Cable",
      "server": "Puma"
    },
    "frontend": {
      "build_tool": "Vite",
      "javascript_framework": "Stimulus",
      "version": "3.2.2",
      "turbo": "@hotwired/turbo-rails 8.0.16",
      "styling": "Bootstrap 5.3.7",
      "icons": "Bootstrap Icons 1.13.1",
      "additional_libraries": ["jQuery 3.7.1", "Popper.js 2.11.8"]
    },
    "testing": {
      "framework": "RSpec",
      "tools": [
        "Capybara",
        "Factory Bot",
        "Faker",
        "SimpleCov",
        "Brakeman",
        "RuboCop Rails",
        "Slim Lint"
      ]
    },
    "deployment": {
      "tool": "Kamal",
      "configured": true
    }
  },
  "database_schema": {
    "authors": {
      "fields": [
        "id (primary key)",
        "first_name (string)",
        "last_name (string)",
        "additional_information (string)",
        "created_at (datetime)",
        "updated_at (datetime)"
      ],
      "validations": [
        "Requires at least first_name OR last_name"
      ]
    },
    "entries": {
      "fields": [
        "id (primary key)",
        "full_title (text)",
        "publication_date (datetime)",
        "start_page (integer)",
        "end_page (integer)",
        "start_folio (integer)",
        "end_folio (integer)",
        "start_side (string)",
        "end_side (string)",
        "type (integer enum)",
        "isbn (string)",
        "isbn13 (string)",
        "format (integer)",
        "language (string)",
        "publisher (string)",
        "file_location (string)",
        "volume (integer)",
        "series (string)",
        "notes (text)",
        "created_at (datetime)",
        "updated_at (datetime)"
      ],
      "enums": {
        "type": {
          "book": 0
        }
      },
      "critical_fields": [
        "file_location"
      ]
    },
    "authors_entries": {
      "type": "join_table",
      "fields": [
        "entry_id (integer, not null)",
        "author_id (integer, not null)"
      ],
      "indexes": [
        "author_id and entry_id",
        "entry_id and author_id"
      ]
    }
  },
  "models": {
    "Entry": {
      "file": "app/models/entry.rb",
      "associations": [
        "has_many :authors, through: :authors_entries"
      ],
      "enums": [
        "type: { book: 0 }"
      ],
      "status": "needs_expansion",
      "missing_features": [
        "Additional entry types",
        "Field validations",
        "File management logic",
        "Search functionality"
      ]
    },
    "Author": {
      "file": "app/models/author.rb",
      "associations": [
        "has_many :entries, through: :authors_entries"
      ],
      "validations": [
        "first_name presence (conditional)",
        "last_name presence (conditional)"
      ],
      "status": "functional"
    }
  },
  "controllers": {
    "EntriesController": {
      "file": "app/controllers/entries_controller.rb",
      "implemented_actions": ["new"],
      "missing_actions": ["create", "index", "show", "edit", "update", "destroy"],
      "status": "minimal"
    },
    "AuthorsController": {
      "file": "app/controllers/authors_controller.rb",
      "implemented_actions": ["new_modal", "create"],
      "features": [
        "Turbo Stream responses",
        "Modal-based creation",
        "Flash notices",
        "Error handling"
      ],
      "status": "functional"
    },
    "DashboardController": {
      "status": "unknown"
    }
  },
  "views": {
    "template_engine": "Slim",
    "entries": {
      "files": [
        "new.html.slim",
        "_form.html.slim"
      ],
      "issues": [
        "Incomplete form fields",
        "No file upload UI",
        "Author selection not implemented"
      ]
    },
    "authors": {
      "files": [
        "_form.html.slim",
